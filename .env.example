# Copy to .env (gitignored) for the local compose stack. In prod every one of
# these is a `dokku config:set authentik ...` value instead. No secrets in git.

# 60+ random chars; signs sessions/cookies. Never change it once set:
#   openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=

# Locally: the `postgres` password of survos_postgres (5434).
# Prod: the `authentik` role's password on survos_pg.
AUTHENTIK_POSTGRESQL__PASSWORD=

# Brevo SMTP key (starts xsmtpsib-...), same one mattermost uses.
AUTHENTIK_EMAIL__PASSWORD=

# First boot only: the akadmin user's email/password. Ignored once it exists.
AUTHENTIK_BOOTSTRAP_EMAIL=tac@survos.com
AUTHENTIK_BOOTSTRAP_PASSWORD=

# OIDC client secrets the blueprints read (blueprints/*.yaml, `!Env`). Each
# must match OIDC_CLIENT_SECRET in that app's own config.
#   openssl rand -hex 32
ZM_OIDC_CLIENT_SECRET=
ZM_DEV_OIDC_CLIENT_SECRET=
